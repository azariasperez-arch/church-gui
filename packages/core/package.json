{
  "name": "@church-screen/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bible/rvr1960.json": "./data/rvr1960.json"
  },
  "files": ["dist", "data"],
  "scripts": {
    "build:bible": "node ./scripts/build-bible.mjs",
    "build": "pnpm build:bible && tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
